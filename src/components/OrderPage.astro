---
import '@fontsource/onest/400.css';
import '@fontsource/onest/600.css';
import '@fontsource/onest/800.css';
import '@fontsource/noto-sans-georgian/400.css';
import '@fontsource/noto-sans-georgian/700.css';
import '@fontsource/noto-sans-georgian/800.css';
import '../styles/global.css';
import { config } from '../data/config';
import { menu } from '../data/menu';
import { langs, langLabel, langPath, t, price, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
// Second-language name under each dish, like a bilingual station sign.
const alt: Lang = lang === 'ka' ? 'en' : 'ka';
// IBANs read in groups of four; the copy button keeps the unspaced value.
const groups = (iban: string) => iban.match(/.{1,4}/g) ?? [iban];
const site = Astro.site ?? new URL('http://localhost');

const icon = {
  plus: '<path d="M10 4v12M4 10h12"/>',
  minus: '<path d="M4 10h12"/>',
  up: '<path d="M5 12.5 10 7.5l5 5"/>',
  close: '<path d="m5 5 10 10M15 5 5 15"/>',
  copy: '<rect x="7" y="7" width="9" height="9" rx="1.5"/><path d="M13 4.5H5.5A1.5 1.5 0 0 0 4 6v7.5"/>',
  send: '<path d="M3.5 10h11M10.5 5l5 5-5 5"/>',
  chat: '<path d="M10 3.5a6.5 6.5 0 0 0-5.6 9.8L3.5 16.5l3.3-.9A6.5 6.5 0 1 0 10 3.5Z"/>',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#14213d" />
    <title>{config.name} · {t(lang, 'title')}</title>
    <meta name="description" content={`${t(lang, 'pickupOnly')}. ${t(lang, 'payLine')}.`} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(langPath[l], site).href} />)}
  </head>
  <body data-wa={config.whatsapp} data-open={config.hours.open} data-close={config.hours.close} data-prep={config.prepMinutes}>
    <header class="sign">
      <div class="sign-row">
        <a class="brand" href={langPath[lang]}>
          <span class="brand-dot" aria-hidden="true"></span>
          <span class="brand-name">{config.name}</span>
        </a>
        <nav class="lang" aria-label="Language">
          {
            langs.map((l) => (
              <a href={langPath[l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
                {langLabel[l]}
              </a>
            ))
          }
        </nav>
      </div>
      {config.placeholder && <p class="sign-tag">{t(lang, 'nameToCome')}</p>}
      <p class="status">
        <span class="status-dot" aria-hidden="true"></span>
        <span data-status data-open-text={t(lang, 'open')} data-closed-text={t(lang, 'closed')}>{t(lang, 'open')}</span>
        <span>· {t(lang, 'ready', { n: config.prepMinutes })}</span>
        {config.placeholder && <span class="status-tbc">{t(lang, 'statusTbc')}</span>}
      </p>
      <p class="sign-meta">{t(lang, 'pickupOnly')} · {t(lang, 'payLine')}</p>
    </header>

    <nav class="cats" aria-label={t(lang, 'menu')}>
      {
        menu.map((c) => (
          <a href={`#${c.id}`}>
            {c.name[lang]}
            <span class="cats-n">{c.items.length}</span>
          </a>
        ))
      }
    </nav>

    <div class="layout">
      <main class="menu">
        {config.placeholder && <p class="sample">{t(lang, 'sample')}</p>}
        {
          menu.map((c) => (
            <section class="line-section" id={c.id} aria-labelledby={`h-${c.id}`}>
              <h2 class="interchange" id={`h-${c.id}`}>
                <span>{c.name[lang]}</span>
              </h2>
              <ul class="stations">
                {c.items.map((i) => (
                  <li class="station" data-item={i.id}>
                    <div class="station-text">
                      <h3>{i.name[lang]}</h3>
                      <p class="desc">{i.desc[lang]}</p>
                      <p class="alt" lang={alt}>{i.name[alt]}</p>
                    </div>
                    <div class="station-buy">
                      <span class="price">{price(i.price)}</span>
                      <div class="qty" data-qty="0">
                        <button class="qty-add" type="button" data-add aria-label={t(lang, 'addOne', { name: i.name[lang] })}>
                          <svg viewBox="0 0 20 20" aria-hidden="true" set:html={icon.plus} />
                          <span>{t(lang, 'add')}</span>
                        </button>
                        <button class="qty-btn" type="button" data-remove aria-label={t(lang, 'removeOne', { name: i.name[lang] })}>
                          <svg viewBox="0 0 20 20" aria-hidden="true" set:html={icon.minus} />
                        </button>
                        <output class="qty-n" aria-live="polite" data-count />
                        <button class="qty-btn" type="button" data-add aria-label={t(lang, 'addOne', { name: i.name[lang] })}>
                          <svg viewBox="0 0 20 20" aria-hidden="true" set:html={icon.plus} />
                        </button>
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }

        <section class="info" aria-labelledby="h-info">
          <h2 class="interchange interchange--end" id="h-info"><span>{t(lang, 'info')}</span></h2>
          <dl>
            <div>
              <dt>{t(lang, 'address')}</dt>
              <dd>{config.address[lang]} · {t(lang, 'pickupOnly')}</dd>
            </div>
            <div>
              <dt>{t(lang, 'hours')}</dt>
              <dd>
                {config.hours.open}–{config.hours.close}
                {config.placeholder && <span class="sample sample--inline">{t(lang, 'hoursTbc')}</span>}
              </dd>
            </div>
            <div>
              <dt>{t(lang, 'payment')}</dt>
              <dd>{t(lang, 'payLine')}</dd>
            </div>
            <div>
              <dt>{t(lang, 'contact')}</dt>
              <dd>
                <a href={`https://wa.me/${config.whatsapp}`} rel="noopener">
                  {t(lang, 'writeUs')}
                </a>
              </dd>
            </div>
          </dl>
        </section>
      </main>

      <div class="scrim" data-scrim hidden></div>

      <aside class="dock" data-dock data-state="collapsed" aria-labelledby="h-order">
        <button class="dock-bar" type="button" data-toggle aria-expanded="false" aria-controls="order-panel">
          <span class="track" data-track aria-hidden="true"><span class="track-end"></span></span>
          <span class="dock-row">
            <span class="dock-label">
              <span class="dock-title" id="h-order">{t(lang, 'yourOrder')}</span>
              <span class="dock-count" data-count-label>{t(lang, 'empty')}</span>
            </span>
            <svg class="dock-chev" viewBox="0 0 20 20" aria-hidden="true" set:html={icon.up} />
          </span>
        </button>

        <div class="panel" id="order-panel" data-panel>
          <form class="order" id="order-form" data-form novalidate>
            <ul class="lines" data-lines></ul>
            <p class="lines-empty" data-empty>{t(lang, 'empty')}</p>

            <label class="field">
              <span class="field-label">{t(lang, 'name')}</span>
              <input name="name" autocomplete="given-name" required aria-describedby="name-hint" />
              <span class="field-hint" id="name-hint" data-name-hint data-hint={t(lang, 'nameHint')} data-error={t(lang, 'nameError')}>
                {t(lang, 'nameHint')}
              </span>
            </label>

            <label class="field">
              <span class="field-label">{t(lang, 'pickup')}</span>
              <select name="pickup" data-pickup data-asap={t(lang, 'asap')}>
                <option value="asap">{t(lang, 'asap')}</option>
              </select>
            </label>

            <fieldset class="field pay">
              <legend class="field-label">{t(lang, 'payment')}</legend>
              <label class="pay-opt"><input type="radio" name="pay" value="pickup" checked /><span>{t(lang, 'payPickup')}</span></label>
              <label class="pay-opt"><input type="radio" name="pay" value="bog" /><span>{t(lang, 'payBog')}</span></label>
              <label class="pay-opt"><input type="radio" name="pay" value="tbc" /><span>{t(lang, 'payTbc')}</span></label>
            </fieldset>

            <div class="bank" data-bank hidden>
              <p class="bank-hint">{t(lang, 'transferHint')}</p>
              {
                (['bog', 'tbc'] as const).map((b) => (
                  <div class="bank-acc" data-bank-acc={b} hidden>
                    <span class="bank-iban">
                      {groups(config.banks[b].iban).map((g) => <span>{g}</span>)}
                    </span>
                    {config.placeholder && <span class="bank-sample">{t(lang, 'sampleIban')}</span>}
                    <span class="bank-holder">
                      {t(lang, 'holder')}: {config.banks[b].holder}
                    </span>
                    <button class="copy" type="button" data-copy={config.banks[b].iban} data-copied={t(lang, 'copied')}>
                      <svg viewBox="0 0 20 20" aria-hidden="true" set:html={icon.copy} />
                      <span>{t(lang, 'copy')}</span>
                    </button>
                  </div>
                ))
              }
            </div>

            <label class="field">
              <span class="field-label">
                {t(lang, 'note')} <span class="field-opt">({t(lang, 'optional')})</span>
              </span>
              <textarea name="note" rows="2"></textarea>
            </label>

            <p class="form-error" data-form-error role="alert" data-empty-error={t(lang, 'emptyError')}></p>
          </form>

          <div class="sent" data-sent hidden tabindex="-1">
            <span class="sent-terminus" aria-hidden="true"></span>
            <h2>{t(lang, 'sentTitle')}</h2>
            <p>{t(lang, 'sentBody')}</p>
            <div class="sent-bank" data-sent-bank></div>
            <div class="sent-actions">
              <button type="button" class="ghost" data-back>{t(lang, 'backToOrder')}</button>
              <button type="button" class="ghost" data-new>{t(lang, 'newOrder')}</button>
            </div>
          </div>
        </div>

        <div class="dock-foot" data-foot hidden>
          <button class="dock-meta" type="button" data-meta aria-controls="order-panel">
            <span data-meta-text></span>
            <span class="dock-meta-edit">{t(lang, 'change')}</span>
          </button>
          <button class="send" type="submit" form="order-form">
            <svg viewBox="0 0 20 20" aria-hidden="true" set:html={icon.chat} />
            <span>{t(lang, 'send')}</span>
            <span class="send-total" data-total>{price(0)}</span>
          </button>
        </div>
      </aside>
    </div>

    <script>
      import '../scripts/order';
    </script>
  </body>
</html>
